{
  "name": "studymate-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd studymate && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "install:all": "npm install && cd studymate && npm install && cd ../backend && npm install"
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  }
}
