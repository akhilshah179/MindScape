# MindScape environment template. Copy to .env and fill in. NEVER commit .env.
# Variables starting with VITE_ are bundled into the browser: never put secrets in them.

# ── Server ─────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# TRUST_PROXY=true              # only when behind a reverse proxy / load balancer
VITE_API_URL=http://localhost:5000/api

# ── Authentication ─────────────────────────────────────────────────────────
# local   = built-in accounts (scrypt + signed tokens), stored in the app database
# cognito = AWS Cognito user pool (backend verifies the JWTs)
AUTH_PROVIDER=local
VITE_AUTH_PROVIDER=local
# Required for local auth. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_with_a_long_random_string
# JWT_TTL_SECONDS=604800
# Cognito (when AUTH_PROVIDER=cognito)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
VITE_USER_POOL_ID=
VITE_USER_POOL_CLIENT_ID=

# ── AI (Groq) ──────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b,qwen/qwen3.8-27b
# GROQ_REASONING_EFFORT=low
# GROQ_TIMEOUT_MS=45000

# ── Database ───────────────────────────────────────────────────────────────
# DB_DRIVER=local      -> backend/local-db.json (default when no AWS credentials)
# DB_DRIVER=dynamodb   -> run `npm run db:create-tables` in backend/ first
# DB_DRIVER=local
# LOCAL_DB_PATH=./local-db.json

# ── File storage ───────────────────────────────────────────────────────────
# STORAGE_DRIVER=s3 (default when S3_BUCKET + AWS credentials are set) or local
S3_BUCKET=
S3_REGION=ap-south-1
# STORAGE_LOCAL_DIR=./uploads

# ── AWS credentials (DynamoDB / S3). Prefer IAM roles in production. ───────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Judge0 (code execution) ────────────────────────────────────────────────
JUDGE0_API_URL=https://ce.judge0.com
JUDGE0_API_KEY=
# JUDGE0_CONCURRENCY=3
# Override language ids for self-hosted/RapidAPI instances:
# JUDGE0_LANGUAGE_IDS={"cpp":105,"java":91,"python":100,"javascript":102}

# ── LiveKit (meetings) ─────────────────────────────────────────────────────
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here
LIVEKIT_URL=wss://your-project.livekit.cloud
