# ═══════════════════════════════════════════════════════════════════════════════
# MindScape AI Student OS — Environment Configuration Template
# ═══════════════════════════════════════════════════════════════════════════════

# Server & Network Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000/api

# Groq AI Service (Required for Fast AI Summaries, Quizzes & Chat)
# Obtain your free API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Judge0 Code Execution Engine (RapidAPI)
# Obtain from https://rapidapi.com/judge0-official/api/judge0-ce
JUDGE0_API_KEY=your_rapidapi_judge0_key_here

# LiveKit Video & Audio Streaming (Meetings & Collaborative Arena)
# Obtain from https://cloud.livekit.io
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# AWS Cloud Infrastructure (Cognito, DynamoDB & S3)
# Leave empty for Instant Zero-Config Mode (uses built-in local JSON database & local storage)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS Cognito (Authentication)
VITE_USER_POOL_ID=
VITE_USER_POOL_CLIENT_ID=
VITE_IDENTITY_POOL_ID=

# AWS S3 Storage (PDF Documents & Assets)
VITE_S3_BUCKET=
VITE_S3_REGION=ap-south-1
